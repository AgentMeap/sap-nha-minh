{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null",
        "host": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "state": {
          ".write": "auth != null && root.child('rooms').child($room).child('host').val() === auth.uid"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($room).child('host').val() === auth.uid)"
          }
        },
        "reacts": {
          ".write": "auth != null && root.child('rooms').child($room).child('host').val() === auth.uid",
          "$id": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['e', 't']) && newData.child('e').isString() && newData.child('e').val().length < 8"
          }
        }
      }
    }
  }
}
